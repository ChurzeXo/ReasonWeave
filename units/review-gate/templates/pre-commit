#!/usr/bin/env bash
# 通用 OpenGrep pre-commit 回归门禁（source: ~/Documents/lab/review-gate/）
#
# 仅当基线外出现「新发现」时阻断提交；已写入基线的已知信号放行。
# 这是"回归篱笆"不是"零误报墙"——正常行号变动不会触发，
# 新规则命中新文件/路径才阻断。
#
# 挂载（每仓一次，per-repo local，不污染全局）:
#   git config core.hooksPath .githooks
#   （新克隆需重跑；或把本文件复制到 .git/hooks/pre-commit）
#
# 重新基线（有意为之接受新发现后）:
#   RULESETS="p/default p/rust p/typescript" bash scan.sh review-gate/baseline/baseline.json
#
# opengrep / python 缺失 → 告警并跳过（绝不阻断开发）。
set -uo pipefail

# 非交互 hook 可能没把 ~/.local/bin 放进 PATH
export PATH="$HOME/.local/bin:$PATH"
OG="${OPENGREP_BIN:-__AUTO__}"
if [ "$OG" = "__AUTO__" ]; then
  if [ -x "$HOME/.local/bin/opengrep" ]; then
    OG="$HOME/.local/bin/opengrep"
  else
    OG=$(command -v opengrep || true)
  fi
elif [ -n "$OG" ] && { [ ! -x "$OG" ] && ! command -v "$OG" >/dev/null 2>&1; }; then
  OG=""
fi

USE_RUFF_FALLBACK=0
if [ -z "$OG" ] || (! [ -x "$OG" ] && ! command -v "$OG" >/dev/null 2>&1); then
  RUFF=$(command -v ruff || true)
  if [ -n "$RUFF" ]; then
    echo "⚠️  OpenGrep not found — falling back to Ruff Bandit (S rules) for staged code."
    USE_RUFF_FALLBACK=1
  else
    echo "⚠️  OpenGrep not found — skipping static-analysis gate."
    echo "    Install: https://github.com/opengrep/opengrep/releases (macOS arm64 standalone binary)"
    exit 0
  fi
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
BASELINE_REL="${BASELINE_REL:-review-gate/baseline/baseline.json}"
BASELINE="$REPO_ROOT/$BASELINE_REL"
if [ ! -f "$BASELINE" ]; then
  echo "⚠️  OpenGrep baseline missing at $BASELINE — skipping gate."
  exit 0
fi

# 按项目语言栈调整扫描的扩展名（空格分隔，用 SCAN_EXTS 覆盖）
SCAN_EXTS="${SCAN_EXTS:-py kt kts java rs ts tsx go xml gradle toml}"
EXT_RE="\.(${SCAN_EXTS// /|})$"

# 只扫本次提交真正要落库的暂存代码文件
STAGED_FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && STAGED_FILES+=("$f")
done < <(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACM | grep -E "$EXT_RE" || true)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

# 从 Git Index 中将暂存内容安全还原至独立临时目录进行扫描，确保真实扫描暂存快照
STAGED_DIR=$(mktemp -d /tmp/og-staged-XXXXXX)
TMP=$(mktemp /tmp/og-precommit-XXXXXX.json)
trap 'rm -rf "$STAGED_DIR" "$TMP"' EXIT

EXISTING=()
for f in "${STAGED_FILES[@]}"; do
  dest="$STAGED_DIR/$f"
  mkdir -p "$(dirname "$dest")"
  if git -C "$REPO_ROOT" show ":$f" > "$dest" 2>/dev/null; then
    EXISTING+=("$dest")
  fi
done

if [ ${#EXISTING[@]} -eq 0 ]; then
  exit 0
fi

cd "$REPO_ROOT"

# 规则集 / 排除项与 scan.sh 同语义（按需用环境变量覆盖）
RULESETS="${RULESETS:-p/default p/java}"
CONFIG_ARGS=()
for r in $RULESETS; do
  [ -n "$r" ] && CONFIG_ARGS+=(--config "$r")
done
EXCLUDE_RULES=(
  "python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected"
  "python.lang.security.audit.insecure-transport.urllib.insecure-urlopen.insecure-urlopen"
  "python.lang.security.audit.insecure-file-permissions.insecure-file-permissions"
)
EXCLUDES=$(printf -- '--exclude-rule %s ' ${EXCLUDE_RULES[@]+"${EXCLUDE_RULES[@]}"})

SCAN_EXIT=0
if [ "$USE_RUFF_FALLBACK" = "1" ]; then
  echo "🔍 Ruff Bandit fallback gate: scanning ${#EXISTING[@]} staged file(s)..."
  "$RUFF" check --select S --output-format json "${EXISTING[@]}" > "$TMP" 2>/dev/null || SCAN_EXIT=$?
else
  echo "🔍 OpenGrep gate: scanning ${#EXISTING[@]} staged file(s)..."
  "$OG" scan ${CONFIG_ARGS[@]+"${CONFIG_ARGS[@]}"} --disable-version-check --timeout 60 ${EXCLUDES} \
    --json --output "$TMP" "${EXISTING[@]}" >/dev/null 2>&1 || SCAN_EXIT=$?
fi

PY=$(command -v python3 || command -v python || true)
if [ -z "$PY" ]; then
  echo "⚠️  python3 not found — cannot evaluate gate, skipping."
  exit 0
fi

"$PY" - "$TMP" "$BASELINE" "$STAGED_DIR" "$USE_RUFF_FALLBACK" "$SCAN_EXIT" <<'PYEOF'
import json, sys, os

tmp_path = sys.argv[1]
base_path = sys.argv[2]
staged_dir = os.path.realpath(sys.argv[3]).rstrip("/") + "/"
is_ruff = sys.argv[4] == "1"
scan_exit = int(sys.argv[5])

def load(p, is_ruff_output=False):
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"❌ 门禁评估失败: 无法解析扫描报告 {p}: {e}", file=sys.stderr)
        sys.exit(2)

    if isinstance(data, list):
        if is_ruff_output:
            return [
                {
                    "check_id": item.get("code") or item.get("check_id"),
                    "path": item.get("filename") or item.get("path"),
                    "start": {"line": (item.get("location") or {}).get("row")},
                    "extra": {"severity": "WARNING", "message": item.get("message", "")}
                }
                for item in data
                if isinstance(item, dict)
            ]
        return data
    elif isinstance(data, dict):
        return data.get("results", [])
    return []

cur = load(tmp_path, is_ruff_output=is_ruff)
base = load(base_path, is_ruff_output=False)

def norm(p):
    if not p:
        return ""
    p_real = os.path.realpath(str(p))
    if p_real.startswith(staged_dir):
        return p_real[len(staged_dir):]
    p_str = str(p)
    if p_str.startswith(sys.argv[3].rstrip("/") + "/"):
        return p_str[len(sys.argv[3].rstrip("/") + "/"):]
    return p_str

base_keys = {(r.get("check_id"), norm(r.get("path"))) for r in base if "check_id" in r and "path" in r}
new = [
    r for r in cur
    if ("check_id" in r and "path" in r) and (r.get("check_id"), norm(r.get("path"))) not in base_keys
]

if new:
    gate_name = "Ruff Bandit" if is_ruff else "OpenGrep"
    print(f"❌ {gate_name} gate: {len(new)} new finding(s) beyond accepted baseline:")
    for r in new:
        e = r.get("extra", {})
        line = r.get("start", {}).get("line", "?")
        print(f"   - [{r.get('check_id')}] {norm(r.get('path'))}:{line}  ({e.get('severity', '?')})")
    print(f"\n   Fix the issue, or re-baseline: RULESETS=... bash scan.sh {sys.argv[2]}")
    sys.exit(1)

print(f"✅ Static-analysis gate passed (no new findings vs {len(base)} accepted baseline).")
PYEOF
